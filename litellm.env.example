# Copy to litellm.env (gitignored, mode 600) and fill secrets — never commit.
# See docs/LITELLM_MANAGER_PANEL_PLAN.md:3.2 and llm_inference_manager/app.py:264.
LITELLM_MASTER_KEY=sk-litellm-local-dev-change-me
MANAGER_API_KEY=sk-local-dev
# Upstream providers (optional — add as available; LiteLLM fallbacks handle missing keys gracefully)
SILICONFLOW_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Proxy for remote upstreams (same Squid as offline_prepare_cli.py:18)
HTTP_PROXY=http://192.168.203.2:3128
HTTPS_PROXY=http://192.168.203.2:3128
NO_PROXY=localhost,127.0.0.1,host.docker.internal,redis,qdrant,pgvector,milvus,langfuse,grafana,prometheus,litellm
# LiteLLM host override (host-venv vs Docker)
LITELLM_HOST=http://127.0.0.1:4000
LITELLM_URL=http://127.0.0.1:4000
