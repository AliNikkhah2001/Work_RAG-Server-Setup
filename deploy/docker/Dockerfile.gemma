# Gemma Backend Service Dockerfile (llama.cpp)
# Source: scripts/services/llama_chat_server.py
# Ports: 8080-8084 (one container per GPU/backend)
# GPU: Required (nvidia-container-toolkit)
# Build context: Work_RAG-Server-Setup
# Mounts host site-packages and CUDA libs as volumes at runtime

FROM python:3.12-slim

WORKDIR /app

# Copy backend script
COPY scripts/services/llama_chat_server.py ./

# Non-root user
RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

# Environment
ENV MODEL_PATH=/models/gemma-4-31b.gguf
ENV MODEL_ID=gemma-4-31b
ENV PORT=8080
ENV N_CTX=8192
ENV N_GPU_LAYERS=-1
ENV CUDA_VISIBLE_DEVICES=0
ENV PYTHONPATH=/app:/host-site-packages
ENV LD_LIBRARY_PATH=/usr/local/cuda-12.4/lib64:/host-cuda-libs:$LD_LIBRARY_PATH

VOLUME ["/models"]

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health || exit 1

CMD ["python3", "llama_chat_server.py", "--model", "${MODEL_PATH}", "--host", "0.0.0.0", "--port", "${PORT}", "--n-ctx", "${N_CTX}", "--n-gpu-layers", "${N_GPU_LAYERS}", "--model-id", "${MODEL_ID}"]
