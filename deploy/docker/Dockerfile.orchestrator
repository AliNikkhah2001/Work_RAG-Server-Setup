# Orchestrator (LangGraph) Service Dockerfile
# Port: 8100 | Build context: Work_Credit-RAG_Phase1
FROM python:3.12-slim

WORKDIR /app

COPY components/orchestrator/src/work_rag_orchestrator ./work_rag_orchestrator

RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

ENV KB_BASE_URL=http://127.0.0.1:8000
ENV GUARDRAILS_BASE_URL=http://127.0.0.1:8200
ENV LANGFUSE_HOST=http://127.0.0.1:3000
ENV PORT=8100
ENV PYTHONPATH=/app:/host-site-packages

EXPOSE 8100

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:'+str(__import__('os').environ.get('PORT','8100'))+'/health')" || exit 1

CMD ["python", "-m", "uvicorn", "work_rag_orchestrator.api:create_app --factory", "--host", "0.0.0.0", "--port", "8100"]
