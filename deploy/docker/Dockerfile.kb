# KB Retrieval Service Dockerfile
# Source: components/knowledgebase/kb-manager/kb_manager/web/app.py
# Port: 8000
# Build context: Work_Credit-RAG_Phase1 (parent repo root)
# Copies host's pre-installed Python packages to bypass corporate proxy

FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy host's pre-installed Python packages (bypasses proxy hash issues)
COPY --chown=raguser:raguser offline-prep/venv/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

# Copy KB manager source from submodule
COPY --chown=raguser:raguser components/knowledgebase/kb-manager/kb_manager ./kb_manager

# Non-root user
RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

# Environment
ENV KB_DB_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/kb_manager
ENV KB_REDIS_URL=redis://127.0.0.1:16379/0
ENV KB_REDIS_TTL=600
ENV PORT=8000
ENV PYTHONPATH=/app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health || exit 1

CMD ["python", "-m", "uvicorn", "kb_manager.web.app:app", "--host", "0.0.0.0", "--port", "8000"]
