# Guardrails Service Dockerfile
# Source: components/guardrails/src/work_rag_guardrails/api.py
# Port: 8200
# Build context: Work_Credit-RAG_Phase1 (parent repo root)
# Copies host's pre-installed Python packages to bypass corporate proxy

FROM python:3.12-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy host's pre-installed Python packages (bypasses proxy hash issues)
COPY --chown=raguser:raguser offline-prep/venv/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

# Copy Guardrails source from submodule
COPY --chown=raguser:raguser components/guardrails/src/work_rag_guardrails ./work_rag_guardrails

# Copy policies and allowlists
COPY --chown=raguser:raguser components/guardrails/policies ./policies
COPY --chown=raguser:raguser components/guardrails/kb ./kb

# Non-root user
RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

# Environment
ENV UPSTREAM_LLM_BASE_URL=http://127.0.0.1:9000/v1
ENV UPSTREAM_LLM_MODEL=gemma-4-31b
ENV GUARDRAILS_HOST=0.0.0.0
ENV GUARDRAILS_PORT=8200
ENV PORT=8200
ENV PYTHONPATH=/app

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health || exit 1

CMD ["python", "-m", "uvicorn", "work_rag_guardrails.api:create_app --factory", "--host", "0.0.0.0", "--port", "8200"]
