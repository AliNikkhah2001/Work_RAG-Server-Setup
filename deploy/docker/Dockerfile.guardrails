# Guardrails Service Dockerfile
# Port: 8200 | Build context: Work_Credit-RAG_Phase1
FROM python:3.12-slim

WORKDIR /app

COPY components/guardrails/src/work_rag_guardrails ./work_rag_guardrails
COPY components/guardrails/policies ./policies
COPY components/guardrails/kb ./kb

RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

ENV UPSTREAM_LLM_BASE_URL=http://127.0.0.1:9000/v1
ENV UPSTREAM_LLM_MODEL=gemma-4-31b
ENV GUARDRAILS_HOST=0.0.0.0
ENV GUARDRAILS_PORT=8200
ENV PORT=8200
ENV PYTHONPATH=/app:/host-site-packages

EXPOSE 8200

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:'+str(__import__('os').environ.get('PORT','8200'))+'/health')" || exit 1

CMD ["python", "-m", "uvicorn", "work_rag_guardrails.api:create_app --factory", "--host", "0.0.0.0", "--port", "8200"]
