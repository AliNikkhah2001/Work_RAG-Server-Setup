# Tracing Fallback Collector Dockerfile
# Port: 3000 | Build context: Work_Credit-RAG_Phase1
FROM python:3.12-slim

WORKDIR /app

COPY components/tracing ./tracing

RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

ENV PORT=3000
ENV TRACES_FILE=/tmp/langfuse_traces.jsonl
ENV PYTHONPATH=/app:/host-site-packages

VOLUME ["/tmp"]

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:'+str(__import__('os').environ.get('PORT','3000'))+'/api/public/health')" || exit 1

CMD ["python", "-m", "uvicorn", "tracing.app:app", "--host", "0.0.0.0", "--port", "3000"]
