# LLM Inference Manager Dockerfile
# Port: 9000 | Build context: Work_RAG-Server-Setup
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY llm_inference_manager/app.py ./

RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

ENV PORT=9000
ENV MANAGER_DB_PATH=/data/manager.db
ENV PYTHONPATH=/app:/host-site-packages

VOLUME ["/data", "/logs"]

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health || exit 1

CMD ["python", "app.py"]
