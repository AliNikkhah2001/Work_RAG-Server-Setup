# LLM Inference Manager Dockerfile
# Source: llm_inference_manager/app.py
# Port: 9000
# Build context: Work_RAG-Server-Setup
# Mounts host site-packages as volume at runtime to bypass proxy

FROM python:3.12-slim

WORKDIR /app

# Copy application code
COPY llm_inference_manager/app.py ./

# Non-root user
RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

# Environment
ENV PORT=9000
ENV MANAGER_DB_PATH=/data/manager.db
ENV PYTHONPATH=/app:/host-site-packages

VOLUME ["/data", "/logs"]

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD curl -f http://127.0.0.1:${PORT}/health || exit 1

CMD ["python", "app.py"]
