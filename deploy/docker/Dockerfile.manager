# LLM Inference Manager Dockerfile
# Port: 9000 | Build context: Work_RAG-Server-Setup
FROM python:3.12-slim

WORKDIR /app

COPY llm_inference_manager/app.py ./

RUN useradd -m -u 1000 raguser && chown -R raguser:raguser /app
USER raguser

ENV PORT=9000
ENV MANAGER_DB_PATH=/data/manager.db
ENV PYTHONPATH=/app:/host-site-packages

VOLUME ["/data", "/logs"]

EXPOSE 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:'+str(__import__('os').environ.get('PORT','9000'))+'/health')" || exit 1

CMD ["python", "app.py"]
