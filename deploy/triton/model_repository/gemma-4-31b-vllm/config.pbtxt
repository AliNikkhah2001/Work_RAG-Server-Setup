# Triton vLLM backend - reuses existing GGUF Q4_K_M without new download (Option B: fast path)
# This is the "Triton-optimized reuse" pool. It fronts the same 19.6GB GGUF via
# vLLM's Triton-kernel + continuous batching + PagedAttention stack.
# Mount: /models -> deploy/triton/model_repository ; /hf -> offline-prep/models/huggingface
name: "gemma-4-31b-vllm"
backend: "vllm"
max_batch_size: 8
input [
  {
    name: "text_input"
    data_type: TYPE_STRING
    dims: [ 1 ]
  },
  {
    name: "parameters"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
output [
  {
    name: "text_output"
    data_type: TYPE_STRING
    dims: [ 1 ]
  }
]
parameters: { key: "model" value: { string_value: "/hf/bartowski_google_gemma-4-31B-it-GGUF/google_gemma-4-31B-it-Q4_K_M.gguf" } }
parameters: { key: "load_format" value: { string_value: "gguf" } }
parameters: { key: "quantization" value: { string_value: "gguf" } }
parameters: { key: "gpu_memory_utilization" value: { string_value: "0.90" } }
parameters: { key: "max_model_len" value: { string_value: "8192" } }
parameters: { key: "enforce_eager" value: { string_value: "false" } }
parameters: { key: "enable_prefix_caching" value: { string_value: "true" } }
instance_group [{ kind: KIND_GPU count: 1 gpus: [0] }]
dynamic_batching { preferred_batch_size: [4, 8] max_queue_delay_microseconds: 10000 }
