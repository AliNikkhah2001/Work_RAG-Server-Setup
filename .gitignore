# The curated reports live in docs/ instead.
offline-prep/
dify/
.deepeval/

# ===== Runtime / build artifacts =====
logs/
pip-*/
pip_cache/
tmp*
*.log
*.tar

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
prep_venv/
venv/
.venv/

# ===== OS / editor =====
.DS_Store
*.swp
deploy/data_plane_status.json

# ===== Runtime DB/wal state (never commit) =====
deploy/monitoring/prometheus-data/
deploy/monitoring/grafana-data/

deploy/gateway/.htpasswd.public
deploy/gateway/.public_pass

# ===== LiteLLM secrets (never commit) =====
litellm.env
litellm-*.env
.opencode/litellm.env

# ===== LightRAG runtime storage =====
rag_storage/
llm_inference_manager/manager.db

# Ops evidence packs belong to Work_RAG_HealthCheck, not this repo.
